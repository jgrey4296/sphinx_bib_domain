#  .envrc -*- mode: sh -*-
# See https://direnv.net/
# export VAR=VAL
# PATH_add val

# venv location
if [[ -z "$READTHEDOCS" ]]; then
    export UV_PROJECT_ENVIRONMENT="$PWD/.temp/venv"
else
    export UV_PROJECT_ENVIRONMENT="$READTHEDOCS_VIRTUALENV_PATH"
fi
if [[ -d "$UV_PROJECT_ENVIRONMENT" ]]; then
    source "$UV_PROJECT_ENVIRONMENT/bin/activate"
fi

# user local
PATH_add "$HOME/.local/bin"

# asdf
PATH_add "$ASDF_DATA_DIR/shims"
asdf reshim

# For repo-local tasks
PATH_add "$PWD/.tasks"

# For polyglot glue
export POLYGLOT_ROOT="$PWD"
export POLYGLOT_SRC="sphinx_bib_domain"
export POLYGLOT_TEMP="$PWD/.temp"
export POLYGLOT_DOCS="$POLYGLOT_TEMP/docs"
export POLYGLOT_SPHINX_CONF_DIR="sphinx_bib_domain/_docs"
export TOWNCRIER_CHANGE_DIR="$PWD/sphinx_bib_domain/_docs/_changes"

export POLYGLOT_SPHINX_BUILDER="bibhtml"
export BIBLIO_TEMPLATE_DIR="$PWD/templates_"
export POLYGLOT_ENV_PREFIXES="BIBLIO"

export POLYGLOT_TEST_BUILD_DIR="${POLYGLOT_SRC}/__tests/test_build"
# Pre-commit skipping:
# export SKIP=""

# h : h : h+o+o+o
export LIBRARIAN_HANDLERS="lsp:py-lsp:mypy:flycheck"
